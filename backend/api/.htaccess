<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /api/

# Enable CORS Headers
Header always set Access-Control-Allow-Origin "*"
Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"

# Handle Preflight OPTIONS requests
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ - [R=200,L]

# Direct rewrites for clean endpoints
RewriteRule ^health/?$ health.php [QSA,L]
RewriteRule ^auth/login/?$ auth.php?action=login [QSA,L]
RewriteRule ^auth/register/?$ auth.php?action=register [QSA,L]
RewriteRule ^complaints/?$ complaints.php [QSA,L]
RewriteRule ^leads/?$ leads.php [QSA,L]
RewriteRule ^deals/?$ deals.php [QSA,L]
RewriteRule ^contacts/?$ contacts.php [QSA,L]
RewriteRule ^tasks/?$ tasks.php [QSA,L]
RewriteRule ^vendors/?$ vendors.php [QSA,L]
RewriteRule ^quotes/?$ quotes.php [QSA,L]
RewriteRule ^users/?$ users.php [QSA,L]

# Fallback all other requests through index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>
